{
    // IntelliSense を使用して利用可能な属性を学べます。
    // 既存の属性の説明をホバーして表示します。
    // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch vuln-lab",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}"
        },
        {
            // CSRF の罠ページ(別モジュール trap/)。単体でも起動できる。
            "name": "Launch Trap Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/trap"
        }
    ],
    "compounds": [
        {
            // 本体と罠ページを同時に起動する。どちらかを止めると両方止まる。
            "name": "Launch vuln-lab + Trap",
            "configurations": [
                "Launch vuln-lab",
                "Launch Trap Server"
            ],
            "stopAll": true
        }
    ]
}
